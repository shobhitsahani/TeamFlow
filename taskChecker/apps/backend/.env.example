# ---------- TeamFlow API environment (copy to .env) ----------
# HTTP
PORT=4002
NODE_ENV=development

# Postgres — single source of truth is the local docker-compose stack.
# The app connects as NON-superuser `teamflow` so RLS is enforced
# (see docker/init.sql; superusers bypass row-level security).
# Provisioning (migrate/seed) instead uses the docker-compose superuser:
#   DATABASE_MIGRATE_URL=postgres://postgres:postgres@localhost:5432/teamflow bun run db:migrate
DATABASE_URL=postgres://teamflow:teamflow@localhost:5432/teamflow
# DATABASE_REPLICA_URL=postgres://teamflow:teamflow@localhost:5433/teamflow

# Redis (cache + rate-limit + pub/sub + BullMQ transport)
REDIS_URL=redis://localhost:6379

# Auth
# Generate with: openssl rand -base64 48  (or node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=dev-only-change-me-at-least-32-chars-with-randomness
ACCESS_TOKEN_TTL=15m

# Sign in with Google (optional — when unset, POST /v1/auth/google returns 503
# and the frontend renders the Google button disabled).
# Create a Web client ID at https://console.cloud.google.com/apis/credentials
# (Authorized JavaScript origins: your frontend origin, e.g. http://localhost:3000).
# Comma-separated to allow multiple origins/clients (web + local dev).
#   GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com

# Blob store (S3-compatible). UPLOAD_BACKEND=memory|s3
UPLOAD_BACKEND=memory
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=teamflow-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
PUBLIC_BASE_URL=http://localhost:4002
# Web app origin — invite links are built against this, not the API above.
# Also the production CORS allowlist, with CORS_ORIGINS (comma-separated extras).
FRONTEND_BASE_URL=http://localhost:4000
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Invite + verification email delivery via Supabase Auth (mailer-only, no
# separate mail provider needed for basic delivery — Supabase's built-in
# mailer; configure custom SMTP in the Supabase dashboard for prod volume).
# Optional: when unset, invites are manual-relay only (the API still returns
# the link + code). Get keys at Dashboard → Project Settings → API keys
# (service_role is SECRET — never commit it, never expose it to the browser).
#   SUPABASE_URL=https://lnplireboawtrfpwpcdd.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#   SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Dashboard email setup (Auth → Email Templates + URL Configuration):
#   Invite template: render {{ .Data.invitation_url }} + {{ .Data.invite_code }}
#   Magic Link template: same fields (existing-user fallback) + {{ .Data.delete_code }}
#   URL Configuration: allowlist the frontend origin(s), e.g. your *.vercel.app
#   URL and http://localhost:4000 — else redirect_to is ignored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Worker knobs
WORKER_WEBHOOK_RETRIES=10
# How often overdue open tasks are moved back to backlog (ms).
DEADLINE_SWEEP_MS=300000
WORKER_NOTIFICATION_PRIORITY=10
LOG_LEVEL=info