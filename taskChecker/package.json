{
  "name": "TeamFlow",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=!TeamFlow",
    "dev": "turbo run dev --filter=!docs --filter=!TeamFlow",
    "lint": "turbo run lint --filter=!TeamFlow",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types --filter=!TeamFlow"
  },
  "dependencies": {
    "turbo": "^2.10.12"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
