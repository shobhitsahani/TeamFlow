{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "DATABASE_URL_4",
    "DATABASE_MIGRATE_URL",
    "DATABASE_REPLICA_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_SECRET_4",
    "ALLOW_AUTH_FALLBACK",
    "ACCESS_TOKEN_TTL",
    "UPLOAD_BACKEND",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_REGION",
    "PUBLIC_BASE_URL",
    "FRONTEND_BASE_URL",
    "CORS_ORIGINS",
    "DEADLINE_SWEEP_MS",
    "WORKER_WEBHOOK_RETRIES",
    "WORKER_NOTIFICATION_PRIORITY",
    "LOG_LEVEL",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_ANON_KEY",
    "SUPABASE_PUBLISHABLE_KEY",
    "TEAMFLOW_IT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
